+def _prefill_like_scheduler(manager, mock, request):
+    """Prefix lookup + Mamba-aligned chunking + allocation, as the scheduler
+    does it. Returns (hit, shared_prefix_boundary, chunk ends)."""
+    blocks, hit, boundary = manager.get_computed_blocks(request)
+    request.shared_prefix_boundary = boundary
+    ends, pos = [], hit
+    while pos < request.num_prompt_tokens:
+        want = min(mock.max_num_scheduled_tokens, request.num_prompt_tokens - pos)
+        if not ends:
+            n = Scheduler._mamba_block_aligned_split(mock, request, want, hit, 0)
+            assert manager.allocate_slots(request, n, hit, blocks, 1) is not None
+            request.num_computed_tokens = hit + n
+        else:
+            n = Scheduler._mamba_block_aligned_split(mock, request, want)
+            assert manager.allocate_slots(request, n, num_lookahead_tokens=1)
+            request.num_computed_tokens += n
+        pos += n
+        ends.append(pos)
+        _, retained = manager.take_kv_cache_block_copies()
+        manager.block_pool.free_blocks(retained)
+        manager.new_step_starts()
+    return hit, boundary, ends
+
+
+@pytest.mark.parametrize("prompt_len", [21, 27, 29, 35])
+def test_eagle_partial_tail_is_reachable_by_exact_repeat(prompt_len: int):
+    """With Eagle, full attention drops one hash unit from every hit, so the
+    Mamba partial tail must sit one unit before the last prompt hash
+    boundary. Otherwise an exact repeat misses it, falls back to a block
+    boundary, gets a shared-prefix junction, and is chunked differently from
+    the original request (different kernel shapes -> different logits)."""
+    hash_block_size, block_size = 2, 8
+    manager = make_full_mamba_manager(
+        dcp_world_size=1,
+        hash_block_size=hash_block_size,
+        full_block_size=block_size,
+        mamba_block_size=block_size,
+        num_blocks=64,
+        use_eagle=True,
+    )
+    mock = SimpleNamespace(
+        cache_config=SimpleNamespace(block_size=block_size),
+        max_num_scheduled_tokens=64,
+        scheduler_config=SimpleNamespace(long_prefill_token_threshold=0),
+        use_eagle=True,
+        hash_block_size=hash_block_size,
+        mamba_partial_cache_hit=manager.coordinator.enable_partial_hash_hits,
+        mamba_has_prefill_checkpoint_blocks=False,
+    )
+    assert mock.mamba_partial_cache_hit
+    token_ids = list(range(prompt_len))
+
+    first = make_request("first", token_ids, hash_block_size, sha256)
+    hit, _, first_ends = _prefill_like_scheduler(manager, mock, first)
+    assert hit == 0
+    manager.free(first)
+    manager.new_step_starts()
+
+    repeat = make_request("repeat", token_ids, hash_block_size, sha256)
+    hit, boundary, repeat_ends = _prefill_like_scheduler(manager, mock, repeat)
+    assert hit == prompt_len // hash_block_size * hash_block_size - hash_block_size
+    assert boundary == 0
+    # The repeat recomputes exactly the original request's last chunk(s).
+    assert repeat_ends == [e for e in first_ends if e > hit]
