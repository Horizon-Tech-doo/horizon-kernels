From 2aa86b624f69c2123708c9f852719f2ff6d741a9 Mon Sep 17 00:00:00 2001
From: Hamza Abdagic <hamza.abdagic@horizon-tech.io>
Date: Sun, 27 Sep 2026 19:47:42 +0200
Subject: [PATCH] [Bugfix][Kernel] Restrict GDN fwd-h kernel to num_warps=2 on
 Blackwell

Triton <= 3.7 miscompiles the state recurrence of
chunk_gated_delta_rule_fwd_kernel_h_blockdim64 on Blackwell with num_warps=4
(triton-lang/triton#9871, #10590). flash-linear-attention restricted the kernel
to 2 warps on Blackwell (fla-org/flash-linear-attention#953); the vendored copy
still autotunes over [2, 4]. On long prompts split by chunked prefill, the
chunks that start from a carried-over state go wrong (#53305).

Signed-off-by: Hamza Abdagic <hamza.abdagic@horizon-tech.io>
---
 .../flash_linear_attention/ops/chunk_delta_h.py          | 9 +++++++--
 vllm/third_party/flash_linear_attention/ops/utils.py     | 2 ++
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py b/vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py
index eb1c3af152..f21d87a805 100644
--- a/vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py
+++ b/vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py
@@ -14,11 +14,16 @@ from vllm.triton_utils import tl, triton
 
 from .index import prepare_chunk_indices, prepare_chunk_offsets
 from .op import exp, exp2
-from .utils import FLA_CHUNK_SIZE, use_cuda_graph
+from .utils import FLA_CHUNK_SIZE, is_nvidia_blackwell, use_cuda_graph
 
 NUM_WARPS = [2, 4, 8, 16]
 # Triton's AMD backend fails to lower this kernel with num_stages=4.
 _CHUNK_DELTA_H_NUM_STAGES = [2, 3] if torch.version.hip else [2, 3, 4]
+# Triton <= 3.7 miscompiles this kernel's state recurrence on Blackwell with
+# num_warps=4 (triton-lang/triton#9871, #10590). On long prompts split by chunked
+# prefill, the chunks that start from a carried-over state (h0) go wrong (#53305).
+# Same restriction as flash-linear-attention upstream (fla-org/...#953).
+_FWD_H_NUM_WARPS = [2] if is_nvidia_blackwell else [2, 4]
 
 
 @triton.heuristics(
@@ -34,7 +39,7 @@ _CHUNK_DELTA_H_NUM_STAGES = [2, 3] if torch.version.hip else [2, 3, 4]
 @triton.autotune(
     configs=[
         triton.Config({"BV": BV}, num_warps=num_warps, num_stages=num_stages)
-        for num_warps in [2, 4]
+        for num_warps in _FWD_H_NUM_WARPS
         for num_stages in _CHUNK_DELTA_H_NUM_STAGES
         for BV in [32, 64]
     ],
diff --git a/vllm/third_party/flash_linear_attention/ops/utils.py b/vllm/third_party/flash_linear_attention/ops/utils.py
index d8e7db9349..312b7c5ee2 100644
--- a/vllm/third_party/flash_linear_attention/ops/utils.py
+++ b/vllm/third_party/flash_linear_attention/ops/utils.py
@@ -152,6 +152,8 @@ is_nvidia_hopper = is_nvidia and (
     "NVIDIA H" in torch.cuda.get_device_name(0)
     or torch.cuda.get_device_capability()[0] >= 9
 )
+# Blackwell (sm_100 / sm_103 / sm_120): see chunk_delta_h.py (Triton recurrence race).
+is_nvidia_blackwell = is_nvidia and torch.cuda.get_device_capability()[0] in (10, 12)
 use_cuda_graph = is_nvidia and os.environ.get("FLA_USE_CUDA_GRAPH", "0") == "1"
 is_gather_supported = hasattr(triton.language, "gather")
 is_tma_supported = (
-- 
2.55.0

