new file mode 100644
index 0000000..f440ba9
--- /dev/null
+++ b/testing/python/amd/test_tilelang_hip_gemm_schedule.py
@@ -0,0 +1,90 @@
+"""T.Kernel(gemm_schedule="pgr2"): the compiler emits the K loop as one asm block for a plain GEMM kernel."""
+
+import logging
+
+import pytest
+import tilelang
+import tilelang.rocm.language as T
+import tilelang.testing
+import torch
+
+SCHEDULED = "v_mfma_f32_16x16x16f16"
+
+
+def _gemm(M, N, K, bM, bN, schedule="pgr2", extra_clear=False):
+    @T.prim_func
+    def main(
+        A: T.Tensor((M, K), T.float16),
+        B: T.Tensor((N, K), T.float16),
+        C: T.Tensor((M, N), T.float16),
+    ):
+        with T.Kernel(T.ceildiv(N, bN), T.ceildiv(M, bM), threads=256, gemm_schedule=schedule) as (bx, by):
+            A_s = T.alloc_shared((bM, 64), T.float16)
+            B_s = T.alloc_shared((bN, 64), T.float16)
+            C_l = T.alloc_fragment((bM, bN), T.float32)
+            T.clear(C_l)
+            for k in T.serial(T.ceildiv(K, 64)):
+                T.copy(A[by * bM, k * 64], A_s)
+                T.copy(B[bx * bN, k * 64], B_s)
+                T.gemm(A_s, B_s, C_l, transpose_B=True)
+                if extra_clear:
+                    T.clear(C_l)
+            T.copy(C_l, C[by * bM, bx * bN])
+
+    return main
+
+
+@tilelang.testing.requires_rocm
+@pytest.mark.parametrize(("M", "N", "K", "bM", "bN"), [(512, 256, 192, 256, 128), (256, 512, 256, 128, 256), (1024, 1024, 512, 256, 128)])
+def test_schedule_is_emitted_and_correct(M, N, K, bM, bN):
+    kernel = tilelang.compile(_gemm(M, N, K, bM, bN), out_idx=[-1], target="hip")
+    assert SCHEDULED in kernel.get_kernel_source()
+    A = torch.randn(M, K, dtype=torch.float32, device="cuda").half()
+    B = torch.randn(N, K, dtype=torch.float32, device="cuda").half()
+    out = kernel(A, B)
+    ref = A.float() @ B.float().T
+    assert ((out.float() - ref).norm() / ref.norm()).item() < 2e-3
+
+
+@tilelang.testing.requires_rocm
+@pytest.mark.parametrize(
+    ("args", "reason"),
+    [
+        ((512, 256, 128, 256, 128), "does not fit"),  # K too small
+        ((512, 256, 192, 128, 128), "tile 128x128"),  # tile the schedule does not have
+    ],
+)
+def test_unsupported_shape_falls_back_with_a_warning(args, reason):
+    messages = []
+
+    class Collect(logging.Handler):
+        def emit(self, record):
+            messages.append(record.getMessage())
+
+    logger = logging.getLogger("tilelang.rocm.transform.schedule_gemm")
+    handler = Collect()
+    logger.addHandler(handler)
+    tilelang.disable_cache()  # the pass does not run on a cache hit
+    try:
+        kernel = tilelang.compile(_gemm(*args), out_idx=[-1], target="hip")
+    finally:
+        tilelang.enable_cache()
+        logger.removeHandler(handler)
+    assert SCHEDULED not in kernel.get_kernel_source()
+    assert any("gemm_schedule ignored" in m and reason in m for m in messages)
+
+
+@tilelang.testing.requires_rocm
+def test_other_loop_bodies_fall_back():
+    kernel = tilelang.compile(_gemm(512, 256, 192, 256, 128, extra_clear=True), out_idx=[-1], target="hip")
+    assert SCHEDULED not in kernel.get_kernel_source()
+
+
+@tilelang.testing.requires_rocm
+def test_no_option_keeps_llvm_schedule():
+    kernel = tilelang.compile(_gemm(512, 256, 192, 256, 128, schedule=None), out_idx=[-1], target="hip")
+    assert SCHEDULED not in kernel.get_kernel_source()
+
+
+if __name__ == "__main__":
+    tilelang.testing.main()
