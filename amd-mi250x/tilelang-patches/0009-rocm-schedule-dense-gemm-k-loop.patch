@@ -0,0 +1,311 @@
+"""Hand-designed K-loop schedule for dense fp16 GEMM on gfx90a.
+
+A kernel opts in with ``T.Kernel(..., gemm_schedule="pgr2")``. This pass recognizes the launch body
+
+    C_l = 0
+    for k in serial(K // 64):
+        copy(A[y * bM, k * 64], A_s)
+        copy(B[x * bN, k * 64], B_s)
+        gemm(A_s, B_s, C_l, transpose_B=True)
+    copy(C_l, C[y * bM, x * bN])
+
+and replaces it with one generated asm block, because no LLVM form of this loop reaches the same throughput (0.72 to 0.82 of hipBLASLt on MI250X against 1.06 to
+1.11 for this schedule on a quiet node). Anything else compiles as usual, with a warning naming the reason. The swizzled grid is part of the schedule, so a
+T.use_swizzle in the kernel is not honoured for the rows the schedule writes.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from tvm import arith
+from tvm import tirx as tir
+from tvm.ir import Op, PointerType, PrimType
+from tvm.tirx.transform import prim_func_pass
+
+logger = logging.getLogger(__name__)
+
+_COPY, _FILL, _GEMM = Op.get("tl.tileop.copy"), Op.get("tl.tileop.fill"), Op.get("tl.tileop.gemm")
+_REGION = Op.get("tl.region")
+
+
+def _schedule_source(M, N, K, bM, bN, sw="c8", rdiv=1, pad=32, fr=0.25):
+    """One inline asm block for the K loop of an M x N x K fp16 GEMM, tile bM x bN x 64, in the layout of Tensile's PGR2.
+
+    Memory operations are spread between v_mfma_f32_16x16x16f16 instructions, barriers do not stop math, and accumulators stay in AGPRs. LLVM keeps none of
+    this: it clusters loads and moves memory operations out of MFMA runs, so the K loop is emitted whole. Hazards are handled by the nops written here.
+    pad: LDS row padding in bytes. sw: grid swizzle, "c8" is a column raster of panel 8. rdiv, fr: how reads and writes spread over the MFMAs.
+    Returns (source of an always-inline hand_body(A, B, C, L), dynamic LDS bytes). Raises ValueError when the shape does not fit."""
+    CH = 64
+    rowa = rowb = CH * 2 + pad
+    ta = bM * rowa
+    dyn = ta + bN * rowb
+    im, jn, n16 = bM // 32, bN // 32, CH // 16
+    tpr, nva, nvb, nch = 2 * n16, n16 * bM // 128, n16 * bN // 128, K // CH
+    vrow, lrowa, lrowb = (128 // n16) * K, (128 // n16) * rowa, (128 // n16) * rowb
+    if nch < 3 or K % CH or M % bM or N % bN or dyn > 65536 or sorted((bM, bN)) != [128, 256]:
+        raise ValueError(f"schedule does not take {M}x{N}x{K} tile {bM}x{bN} with {dyn} B of LDS")
+    xa = 8
+    xb = xa + im * 4
+    ya = xb + jn * 4
+    yb = ya + im * 4
+    st = yb + jn * 4
+    vend = st + (nva + nvb) * 4
+    L = []
+    e = L.append
+
+    def vt(b, n=4):
+        return f"v[{b}:{b + n - 1}]"
+
+    def mf(ki):
+        a, b = (ya, yb) if ki & 1 else (xa, xb)
+        return [f"v_mfma_f32_16x16x16f16 %[c{i * jn + j}], {vt(b + j * 4 + kp * 2, 2)}, {vt(a + i * 4 + kp * 2, 2)}, %[c{i * jn + j}]"
+                for kp in range(2) for i in range(im) for j in range(jn)]
+
+    def rd(ki):
+        a, b = (ya, yb) if ki & 1 else (xa, xb)
+        return [f"ds_read_b128 {vt(a + i * 4)}, %[lra] offset:{i * 16 * rowa + ki * 64}" for i in range(im)] + \
+               [f"ds_read_b128 {vt(b + j * 4)}, %[lrb] offset:{ta + j * 16 * rowb + ki * 64}" for j in range(jn)]
+
+    S = [(f"ds_write_b128 %[lw], {vt(st + v * 4)} offset:{v * lrowa}",
+          f"buffer_load_dwordx4 {vt(st + v * 4)}, %[voa], s[60:63], {'0' if v == 0 else f's{68 + v}'} offen") for v in range(nva)] + \
+        [(f"ds_write_b128 %[lw], {vt(st + (nva + v) * 4)} offset:{ta + v * lrowb}",
+          f"buffer_load_dwordx4 {vt(st + (nva + v) * 4)}, %[vob], s[64:67], {'0' if v == 0 else f's{68 + v}'} offen") for v in range(nvb)]
+    ns = len(S)
+
+    def bump():
+        e("s_cmp_gt_u32 s76, 2")
+        e("s_cselect_b32 s77, %[stp], 0")
+        e("s_add_u32 s60, s60, s77")
+        e("s_addc_u32 s61, s61, 0")
+        e("s_add_u32 s64, s64, s77")
+        e("s_addc_u32 s65, s65, 0")
+
+    def window():
+        m1, r0 = mf(1), rd(0)
+        w1 = len(m1)
+        wn = int(w1 * (1 - fr))
+        gapw, gapr, si, ri, barr = max(1, wn // ns), max(1, (w1 - wn) // len(r0)), 0, 0, False
+
+        def put(i):
+            e(f"s_waitcnt vmcnt({ns - 1})")
+            e(S[i][0])
+            e(S[i][1])
+
+        for idx, m in enumerate(m1):
+            e(m)
+            if si < ns and idx % gapw == 0:
+                if si == 0:
+                    bump()
+                put(si)
+                si += 1
+            if idx >= wn:
+                if not barr:
+                    while si < ns:
+                        put(si)
+                        si += 1
+                    e("s_waitcnt lgkmcnt(0)")
+                    e("s_barrier")
+                    barr = True
+                if (idx - wn) % gapr == 0 and ri < len(r0):
+                    e(r0[ri])
+                    ri += 1
+        while ri < len(r0):
+            e(r0[ri])
+            ri += 1
+
+    e("s_nop 4")
+    for i, x in enumerate(["%[a0]", "%[a1]", "%[a2]", "%[a3]", "%[b0]", "%[b1]", "%[b2]", "%[b3]"]):
+        e(f"s_mov_b32 s{60 + i}, {x}")
+    for v in range(1, 8):
+        e(f"s_mov_b32 s{68 + v}, %[so{v}]")
+    e("s_mov_b32 s76, %[cnt]")
+    for _, l in S:
+        e(l)
+    e("s_waitcnt vmcnt(0)")
+    for w, _ in S:
+        e(w)
+    bump()
+    for _, l in S:
+        e(l)
+    e("s_waitcnt lgkmcnt(0)")
+    e("s_barrier")
+    for r in rd(0):
+        e(r)
+    e("LOOP%=:")
+    e("s_waitcnt lgkmcnt(0)")
+    m0, r1, ri = mf(0), rd(1), 0
+    gap = max(1, (len(m0) // rdiv) // len(r1))
+    for idx, m in enumerate(m0):
+        e(m)
+        if ri < len(r1) and idx % gap == 0:
+            e(r1[ri])
+            ri += 1
+    while ri < len(r1):
+        e(r1[ri])
+        ri += 1
+    e("s_waitcnt lgkmcnt(0)")
+    e("s_barrier")
+    window()
+    e("s_sub_u32 s76, s76, 1")
+    e("s_cmp_eq_u32 s76, 0")
+    e("s_cbranch_scc0 LOOP%=")
+    e("s_waitcnt vmcnt(0) lgkmcnt(0)")
+    e("s_nop 7")
+    e("s_nop 7")
+    e("s_nop 7")
+    asm = "\\n\\t".join(L)
+    ncl = (bM * bN) // 1024
+    outs = ", ".join(f'[c{i}] "+a"(c{i})' for i in range(ncl))
+    ins = [f'[a{i}] "s"(ra[{i}])' for i in range(4)] + [f'[b{i}] "s"(rb[{i}])' for i in range(4)] + \
+          [f'[so{v}] "s"((uint)({v * vrow * 2}))' for v in range(1, 8)] + \
+          [f'[stp] "s"((uint)({CH * 2}))', f'[cnt] "s"((uint)({nch}))', '[voa] "v"(voa)', '[vob] "v"(vob)', '[lw] "v"(lw)', '[lra] "v"(lra)', '[lrb] "v"(lrb)']
+    cl = [f'"v{i}"' for i in range(8, vend)] + [f'"s{i}"' for i in list(range(60, 68)) + list(range(69, 78))] + ['"scc"', '"memory"']
+    swline = "const int by=(int)blockIdx.y,bx=(int)blockIdx.x;" if not sw else "const dim3 d3_=tl::rasterization2D%s<%s>(); const int by=(int)d3_.y,bx=(int)d3_.x;" % ("Row" if sw[0] == "r" else "Column", sw[1:])
+    wm, wn = ("(t&127)>>6", "t>>7") if bN == 128 else ("t>>7", "(t&127)>>6")
+    head = "__device__ inline __attribute__((always_inline)) void hand_body(half_t* __restrict__ A, half_t* __restrict__ B, half_t* __restrict__ C, unsigned char* L_) {"
+    clear = " ".join(f"float32x4 c{i}={{0.f,0.f,0.f,0.f}};" for i in range(ncl))
+    src = f"""#include <hip/hip_runtime.h>
+#include <tl_templates/hip/gemm.h>
+#include <tl_templates/hip/copy.h>
+#include <tl_templates/hip/threadblock_swizzle.h>
+{head}
+  const int t=(int)threadIdx.x,l=t&63; const int wm={wm}, wn={wn}; {swline}
+  const int32x4_t ra=make_wave_buffer_resource(A), rb=make_wave_buffer_resource(B);
+  const uint voa=(uint)(2*((by*{bM}+t/{tpr})*{K}+(t%{tpr})*8)), vob=(uint)(2*((bx*{bN}+t/{tpr})*{K}+(t%{tpr})*8));
+  const uint lw=(uint)((t/{tpr})*{rowa}+(t%{tpr})*16), lra=(uint)((wm*{bM // 2}+(t&15))*{rowa}+((l>>4)&3)*16), lrb=(uint)((wn*{bN // 2}+(t&15))*{rowb}+((l>>4)&3)*16);
+  {clear}
+  asm volatile("{asm}" : {outs} : {", ".join(ins)} : {", ".join(cl)});
+  float32x4 cc[{ncl}]={{{",".join(f"c{i}" for i in range(ncl))}}};
+  #pragma unroll
+  for (int i5=0;i5<{ncl};++i5) {{
+    float32x4 v_=cc[i5]; half_t h[4]; uint2 u;
+    *((half_t*)(&(((half2*)(&(u.x)))->x)))=(half_t)(v_[0]); *((half_t*)(&(((half2*)(&(u.x)))->y)))=(half_t)(v_[1]);
+    *((half_t*)(&(((half2*)(&(u.y)))->x)))=(half_t)(v_[2]); *((half_t*)(&(((half2*)(&(u.y)))->y)))=(half_t)(v_[3]);
+    *(uint2*)(C+(((by*{bM}+wm*{bM // 2}+(i5/{jn})*16+(t&15))*{N})+(bx*{bN}+wn*{bN // 2}+(i5%{jn})*16+((t&63)>>4)*4)))=u;
+  }}
+}}
+"""
+    return src, dyn
+
+
+def _region(arg):
+    """(buffer, indices, extents) of a tl.region call."""
+    if not (isinstance(arg, tir.Call) and arg.op.same_as(_REGION) and isinstance(arg.args[0], tir.BufferLoad)):
+        raise ValueError("operand is not a plain tile region")
+    return arg.args[0].buffer, list(arg.args[0].indices), [int(getattr(e, "value", e)) for e in arg.args[2:]]
+
+
+def _value(e):
+    return getattr(e, "value", e)
+
+
+def _ints(*exprs):
+    return [int(_value(e)) for e in exprs]
+
+
+def _same(a, b):
+    return arith.Analyzer().can_prove(a == b)
+
+
+def _call(stmt, op):
+    if not (isinstance(stmt, tir.Evaluate) and isinstance(stmt.value, tir.Call) and stmt.value.op.same_as(op)):
+        raise ValueError(f"expected {op.name}, found {type(stmt).__name__}")
+    return stmt.value
+
+
+def _plan(block, grid):
+    """Checks the launch body against the form in the module docstring. Returns (A, B, C, M, N, K, bM, bN), or raises ValueError with the reason."""
+    if not isinstance(block.body, tir.SeqStmt) or len(block.body.seq) != 3:
+        raise ValueError("launch body is not clear, K loop, store")
+    clear, loop, store = block.body.seq
+    if len(block.alloc_buffers) != 3:
+        raise ValueError("launch must allocate exactly the A tile, the B tile and the accumulator")
+    fill = _call(clear, _FILL)
+    C_l, _, _ = _region(fill.args[0])
+    if not (isinstance(loop, tir.For) and isinstance(loop.body, tir.SeqStmt) and len(loop.body.seq) == 3):
+        raise ValueError("K loop is not copy, copy, gemm")
+    if _value(fill.args[1]) != 0:
+        raise ValueError("accumulator is not cleared to zero")
+    copy_a, copy_b, gemm = (_call(s, op) for s, op in zip(loop.body.seq, (_COPY, _COPY, _GEMM)))
+    A, ia, (bm_a, bk_a) = _region(copy_a.args[0])
+    A_s, _, _ = _region(copy_a.args[1])
+    B, ib, (bn_b, bk_b) = _region(copy_b.args[0])
+    B_s, _, _ = _region(copy_b.args[1])
+    g_a, _, _ = _region(gemm.args[0])
+    g_b, _, _ = _region(gemm.args[1])
+    g_c, _, _ = _region(gemm.args[2])
+    if not (g_a.same_as(A_s) and g_b.same_as(B_s) and g_c.same_as(C_l)):
+        raise ValueError("gemm does not take the tiles the loop loads")
+    if _value(gemm.args[3]) or not _value(gemm.args[4]) or _value(gemm.args[9]):
+        raise ValueError("gemm is not A @ B.T accumulating into its output")
+    bM, bN, bK = _ints(*gemm.args[5:8])
+    if (bm_a, bn_b, bk_a, bk_b, bK) != (bM, bN, 64, 64, 64):
+        raise ValueError(f"tile {bM}x{bN}x{bK} with copies {bm_a}x{bk_a}, {bn_b}x{bk_b}")
+    if str(A.dtype) != "float16" or str(B.dtype) != "float16" or str(C_l.dtype) != "float32":
+        raise ValueError("needs fp16 inputs and an fp32 accumulator")
+    src, dst = _call(store, _COPY).args[:2]
+    if not _region(src)[0].same_as(C_l):
+        raise ValueError("store does not read the accumulator")
+    C, ic, _ = _region(dst)
+    if str(C.dtype) != "float16":
+        raise ValueError("needs an fp16 output")
+    if len(A.shape) != 2 or len(B.shape) != 2 or len(C.shape) != 2 or any(b.strides and _value(b.strides[-1]) != 1 for b in (A, B, C)):
+        raise ValueError("needs 2-D contiguous buffers")
+    M, K, N, K_b, M_c, N_c = _ints(*A.shape, *B.shape, *C.shape)
+    if (K_b, M_c, N_c) != (K, M, N):
+        raise ValueError("A, B and C shapes do not form one GEMM")
+    if "blockIdx.y" not in grid or not (_same(grid["blockIdx.x"].dom.extent, N // bN) and _same(grid["blockIdx.y"].dom.extent, M // bM)):
+        raise ValueError("grid is not N // bN by M // bM")
+    y, x = grid["blockIdx.y"].var, grid["blockIdx.x"].var
+    k = loop.loop_var
+    if not (_same(ia[0], y * bM) and _same(ia[1], k * 64) and _same(ib[0], x * bN) and _same(ib[1], k * 64) and _same(ic[0], y * bM) and _same(ic[1], x * bN)):
